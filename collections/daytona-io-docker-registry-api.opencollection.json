{
  "opencollection": "1.0.0",
  "info": {
    "name": "Daytona admin docker-registry API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "docker-registry",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List registries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.daytona.io/api/docker-registry",
            "headers": [
              {
                "name": "X-Daytona-Organization-ID",
                "value": ""
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List registries"
        },
        {
          "info": {
            "name": "Create registry",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.daytona.io/api/docker-registry",
            "headers": [
              {
                "name": "X-Daytona-Organization-ID",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create registry"
        },
        {
          "info": {
            "name": "Get temporary registry access for pushing snapshots",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.daytona.io/api/docker-registry/registry-push-access",
            "headers": [
              {
                "name": "X-Daytona-Organization-ID",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "regionId",
                "value": "",
                "type": "query",
                "description": "ID of the region where the snapshot will be available (defaults to organization default region)"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get temporary registry access for pushing snapshots"
        },
        {
          "info": {
            "name": "Get registry",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.daytona.io/api/docker-registry/:id",
            "headers": [
              {
                "name": "X-Daytona-Organization-ID",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the docker registry"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get registry"
        },
        {
          "info": {
            "name": "Update registry",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://app.daytona.io/api/docker-registry/:id",
            "headers": [
              {
                "name": "X-Daytona-Organization-ID",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the docker registry"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update registry"
        },
        {
          "info": {
            "name": "Delete registry",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.daytona.io/api/docker-registry/:id",
            "headers": [
              {
                "name": "X-Daytona-Organization-ID",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the docker registry"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete registry"
        }
      ]
    }
  ],
  "bundled": true
}