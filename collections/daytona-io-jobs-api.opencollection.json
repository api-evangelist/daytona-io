{
  "opencollection": "1.0.0",
  "info": {
    "name": "Daytona admin jobs API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "jobs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List jobs for the runner",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.daytona.io/api/jobs",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number of the results"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of jobs to return (default: 100, max: 500)"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter jobs by status"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of jobs to skip for pagination (default: 0)"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a paginated list of jobs for the runner, optionally filtered by status."
        },
        {
          "info": {
            "name": "Long poll for jobs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.daytona.io/api/jobs/poll",
            "params": [
              {
                "name": "timeout",
                "value": "",
                "type": "query",
                "description": "Timeout in seconds for long polling (default: 30, max: 60)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of jobs to return (default: 10, max: 100)"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Long poll endpoint for runners to fetch pending jobs. Returns immediately if jobs are available, otherwise waits up to timeout seconds."
        },
        {
          "info": {
            "name": "Get job details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.daytona.io/api/jobs/:jobId",
            "params": [
              {
                "name": "jobId",
                "value": "",
                "type": "path",
                "description": "ID of the job"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get job details"
        },
        {
          "info": {
            "name": "Update job status",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.daytona.io/api/jobs/:jobId/status",
            "params": [
              {
                "name": "jobId",
                "value": "",
                "type": "path",
                "description": "ID of the job"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update job status"
        }
      ]
    }
  ],
  "bundled": true
}