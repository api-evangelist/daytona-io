{
  "opencollection": "1.0.0",
  "info": {
    "name": "Daytona admin port API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "port",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get active ports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.daytona.io/api/port"
