        {
          "info": {
            "name": "Check if port is in use",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.daytona.io/api/port/:port/in-use",
            "params": [
              {
                "name": "port",
                "value": "",
                "type": "path",
                "description": "Port number (3000-9999)"
              }
            ]
          },
          "docs": "Check if a specific port is currently in use"
        }
      ]
    }
  ],
  "bundled": true
}