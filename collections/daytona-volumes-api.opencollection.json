{
  "opencollection": "1.0.0",
  "info": {
    "name": "Daytona Volumes API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "volumes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all volumes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.daytona.io/api/volumes",
            "headers": [
              {
                "name": "X-Daytona-Organization-ID",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "includeDeleted",
                "value": "",
                "type": "query",
                "description": "Include deleted volumes in the response"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all volumes"
        },
        {
          "info": {
            "name": "Create a new volume",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.daytona.io/api/volumes",
            "headers": [
              {
                "name": "X-Daytona-Organization-ID",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new volume"
        },
        {
          "info": {
            "name": "Get volume details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.daytona.io/api/volumes/:volumeId",
            "headers": [
              {
                "name": "X-Daytona-Organization-ID",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "volumeId",
                "value": "",
                "type": "path",
                "description": "ID of the volume"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get volume details"
        },
        {
          "info": {
            "name": "Delete volume",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.daytona.io/api/volumes/:volumeId",
            "headers": [
              {
                "name": "X-Daytona-Organization-ID",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "volumeId",
                "value": "",
                "type": "path",
                "description": "ID of the volume"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete volume"
        },
        {
          "info": {
            "name": "Get volume details by name",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.daytona.io/api/volumes/by-name/:name",
            "headers": [
              {
                "name": "X-Daytona-Organization-ID",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the volume"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get volume details by name"
        }
      ]
    }
  ],
  "bundled": true
}