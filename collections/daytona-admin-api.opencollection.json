                "type": "query",
                "description": "Page number of the results"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of jobs to return (default: 100, max: 500)"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter jobs by status"
              },
